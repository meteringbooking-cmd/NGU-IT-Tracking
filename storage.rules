rules_version = '2';

// IT Helpdesk attachment rules.
// IMPORTANT: this project is shared with another app. Do NOT replace your existing
// Storage rules. Copy the block between BEGIN and END into them, inside
// `match /b/{bucket}/o { ... }`.

service firebase.storage {
  match /b/{bucket}/o {

    // ===== BEGIN IT HELPDESK =====
    match /it-tickets/{ticketId}/{fileName} {
      function itUser() {
        return /databases/(default)/documents/$('IT Users')/$(request.auth.uid);
      }
      function isItStaff() {
        return request.auth != null
          && firestore.exists(itUser())
          && firestore.get(itUser()).data.active == true;
      }
      // Only IT can open attachments.
      allow read: if isItStaff();
      // Anyone submitting a ticket can upload new files (max 10 MB each), but not overwrite.
      allow create: if request.resource.size < 10 * 1024 * 1024;
      allow update: if false;
      allow delete: if isItStaff();
    }
    // ===== END IT HELPDESK =====

  }
}
